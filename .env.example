# Web
PRESTOCKS_API_URL=https://prestocks.com/api/prestocks
PRESTOCKS_TIMEOUT_MS=5000

# Publisher (no private key is used by the bootstrap writer)
MARKDESK_OUTPUT_PATH=var/marks.json
MARKDESK_SOURCE=live

# Wallet flow cluster (devnet | localnet | mainnet-beta)
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# Override after `anchor keys sync` and deployment; defaults to the source placeholder.
NEXT_PUBLIC_MARKDESK_PROGRAM_ID=7bmrrLhLHKmB4J4H2VjKfU6kUqUFhsmrxpDuatvrCmJk

# Devnet demo: the synthetic Token-2022 base mint written by
# `npm run devnet:bootstrap` (see docs/DEVNET_RUNBOOK.md).
NEXT_PUBLIC_DEMO_BASE_MINT=
NEXT_PUBLIC_DEMO_BASE_SYMBOL=SYN-ANDURIL
