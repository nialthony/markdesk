{
  "name": "markdesk",
  "version": "0.1.0",
  "private": true,
  "description": "Mark-relative OTC orders for tokenized private markets on Solana.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @markdesk/web",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run typecheck:tools && npm run test:scripts && npm run typecheck --workspaces --if-present && npm run test --workspaces --if-present",
    "typecheck:tools": "tsc --noEmit -p tsconfig.tools.json",
    "test:scripts": "tsx --test scripts/devnet/common.test.ts",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "publisher": "npm run start --workspace @markdesk/publisher",
    "inspect:mints": "tsx scripts/inspect-prestocks.ts",
    "devnet:bootstrap": "tsx scripts/devnet/bootstrap.ts",
    "devnet:flow-check": "tsx scripts/devnet/flow-check.ts",
    "devnet:program-id": "tsx scripts/devnet/program-id.ts"
  },
  "engines": {
    "node": ">=20.9"
  },
  "devDependencies": {
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.99.0",
    "@types/node": "^20.17.0",
    "prettier": "3.9.8",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "license": "MIT"
}
